def build_parser():
    parser = argparse.ArgumentParser(
        prog="kora",
        description="one VM at a time, local (tart/QEMU) or cloud "
                    "(QEMU+KVM on a persistent clouddevbox 'kvm')")
    parser.add_argument("--version", action="version", version=f"kora {VERSION}")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("new", help="create the VM (fails if one exists; --force replaces)")
    p.add_argument("os", help="debian | ubuntu | arch | sequoia (see kora list)")
    p.add_argument("--ram", help="memory, e.g. 2G or 2048M")
    p.add_argument("--cpu", type=int, help="vCPUs")
    p.add_argument("--hd", help="disk size, e.g. 20G")
    p.add_argument("--cloud", action="store_true",
                   help=f"create on the persistent '{CLOUD_BOX}' devbox (billable)")
    p.add_argument("--profile", help="AWS profile for --cloud "
                                     "(delegated to clouddevbox's picker when omitted)")
    p.add_argument("--force", action="store_true", help="replace an existing VM")
    p.add_argument("--yes", action="store_true",
                   help="skip the devbox-creation cost prompt")
    p.set_defaults(fn=cmd_new)

    p = sub.add_parser("status", help="active VM state; 'status cloud' shows the devbox")
    p.add_argument("side", nargs="?", choices=["cloud"], default=None)
    p.add_argument("--json", action="store_true", help="machine-readable state")
    p.add_argument("--profile", help="AWS profile (status cloud without an active VM)")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("list", help="catalog of launchable OSes and where they can run")
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("start", help="boot the stopped VM (cloud: starts the box too)")
    p.add_argument("--yes", action="store_true", help="skip cost prompts")
    p.set_defaults(fn=cmd_start)

    p = sub.add_parser("stop", help="graceful shutdown; disk is kept")
    p.set_defaults(fn=cmd_stop)

    p = sub.add_parser("rm", help="delete the VM (disk + state)")
    p.set_defaults(fn=cmd_rm)

    p = sub.add_parser("cmd", help="run a command in the VM (single arg = shell string)")
    p.add_argument("command", nargs=argparse.REMAINDER)
    p.set_defaults(fn=cmd_cmd)

    p = sub.add_parser("ssh", help="interactive shell in the VM")
    p.set_defaults(fn=cmd_ssh)

    p = sub.add_parser("copy", help="scp to/from the VM (exactly one side vm:<path>)")
    p.add_argument("src")
    p.add_argument("dst")
    p.set_defaults(fn=cmd_copy)

    p = sub.add_parser("tun", help="forward localhost:<local> to the VM's 127.0.0.1:<remote>")
    p.add_argument("local_port", type=int)
    p.add_argument("remote_port", type=int)
    p.set_defaults(fn=cmd_tun)

    p = sub.add_parser("vnc", help="print (and open) the VM's display URL")
    p.set_defaults(fn=cmd_vnc)

    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    args.fn(args)
    return 0


if __name__ == "__main__":
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(line_buffering=True)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(1))
    try:
        sys.exit(main())
    except CliError as e:
        print(f"kora: {e}", file=sys.stderr)
        sys.exit(2)
    except KeyboardInterrupt:
        print("\ninterrupted", file=sys.stderr)
        sys.exit(130)
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
