def cmd_cmd(args):
    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        raise CliError("usage: kora cmd <command...>")
    remote = build_remote_command(command)
    state = require_vm()
    if cloud_state(state):
        profile = _ensure_remote(state)
        sys.exit(proxy(profile, ["cmd", remote]))
    sys.exit(run(ssh_argv(state, remote)).returncode)


def cmd_ssh(args):
    state = require_vm()
    if cloud_state(state):
        profile = _ensure_remote(state)
        sys.exit(proxy(profile, ["ssh"], tty=True))
    sys.exit(run(ssh_argv(state, interactive=True)).returncode)


COPY_RE = re.compile(r"^vm:(.*)$")


def parse_copy_spec(src, dst):
    """Exactly one side must be vm:<path>. Local paths that merely contain a
    colon stay local when prefixed ./ or absolute (vm: is the only trigger)."""
    s, d = COPY_RE.match(src), COPY_RE.match(dst)
    if bool(s) == bool(d):
        raise CliError("exactly one of src/dst must be vm:<path> "
                       "(e.g. kora copy report.txt vm:/tmp/)")
    return (s.group(1), dst, False) if s else (d.group(1), src, True)


def cmd_copy(args):
    rpath, lpath, to_vm = parse_copy_spec(args.src, args.dst)
    state = require_vm()
    if cloud_state(state):
        profile = _ensure_remote(state)
        relay = f"/tmp/kora-relay-{uuid.uuid4().hex[:8]}"
        try:
            if to_vm:
                if _cdb("copy", lpath, f"{CLOUD_BOX}:{relay}", "--profile", profile) != 0:
                    raise CliError("copy to the box failed")
                if proxy(profile, ["copy", relay, f"vm:{rpath}"]) != 0:
                    raise CliError("copy from the box into the VM failed")
            else:
                if proxy(profile, ["copy", f"vm:{rpath}", relay]) != 0:
                    raise CliError("copy from the VM to the box failed")
                if _cdb("copy", f"{CLOUD_BOX}:{relay}", lpath, "--profile", profile) != 0:
                    raise CliError("copy from the box failed")
        finally:
            _cdb("ssh", CLOUD_BOX, "--profile", profile, "--",
                 f"rm -f {shlex.quote(relay)}", capture=True)
        return
    argv = scp_argv(state, lpath if to_vm else rpath,
                    rpath if to_vm else lpath, to_vm)
    sys.exit(run(argv).returncode)


def cmd_tun(args):
    for port, which in ((args.local_port, "local"), (args.remote_port, "remote")):
        if not 1 <= port <= 65535:
            raise CliError(f"invalid {which} port {port} (1-65535)")
    state = require_vm()
    if cloud_state(state):
        hop, hop_port = cloud_tunnel(state, state["cloud"]["guest_ssh_port"])
        try:
            c = state["cloud"]
            print(f"tunnel open: localhost:{args.local_port} -> {state['name']}:"
                  f"{args.remote_port} (ctrl-c to close)")
            sys.exit(run(["ssh", *SSH_BASE_OPTS, "-o", "BatchMode=yes",
                          "-p", str(hop_port), "-i", c["guest_key"],
                          "-l", c["guest_user"], "-N",
                          "-L", f"{args.local_port}:127.0.0.1:{args.remote_port}",
                          "127.0.0.1"]).returncode)
        finally:
            hop.terminate()
    user, host, port, key = ssh_target(state)
    print(f"tunnel open: localhost:{args.local_port} -> {state['name']}:"
          f"{args.remote_port} (ctrl-c to close)")
    sys.exit(run(["ssh", *SSH_BASE_OPTS, "-o", "BatchMode=yes", "-p", str(port),
                  "-i", key, "-l", user, "-N",
                  "-L", f"{args.local_port}:127.0.0.1:{args.remote_port}",
                  host]).returncode)


def _open_url(url):
    if HOST_OS == "darwin" and sys.stdout.isatty():
        run(["open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_vnc(args):
    state = require_vm()
    if cloud_state(state):
        disp = state["cloud"]["guest_vnc_display"]
        hop, hop_port = cloud_tunnel(state, 5900 + disp)
        url = f"vnc://127.0.0.1:{hop_port}"
        print(url)
        print("(tunnel held open - ctrl-c to close)")
        _open_url(url)
        try:
            hop.wait()
        except KeyboardInterrupt:
            pass
        finally:
            hop.terminate()
        return
    backend = backend_for(state)
    if not backend.is_running(state):
        raise CliError("VM is not running (kora start)")
    url = backend.vnc_url(state)
    if not url:
        raise CliError(f"no VNC URL yet - check {state.get('tart', {}).get('log', '?')}")
    print(url)
    _open_url(url)


