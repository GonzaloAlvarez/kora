class TartBackend:
    """macOS guests + Linux guests on Apple Silicon via tart. All tart state
    lives under KORA_HOME/tart (TART_HOME) so `kora rm` owns it fully."""
    name = "tart"

    @staticmethod
    def _env():
        # Shared across KORA_HOMEs like cache_dir(): the OCI image pull is
        # tens of GB for sequoia - per-home tart stores would re-pull it on
        # every isolated harness run. Unique VM names keep homes collision-free.
        env = dict(os.environ)
        env["TART_HOME"] = str(default_data_home() / "tart")
        return env

    @classmethod
    def _tart(cls, *argv, capture=False, **kw):
        if capture:
            p = subprocess.run(["tart", *argv], env=cls._env(),
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               text=True, **kw)
            return p.returncode, p.stdout.strip(), p.stderr
        return run(["tart", *argv], env=cls._env(), **kw).returncode

    @classmethod
    def create(cls, vm):
        if not shutil.which("tart"):
            raise CliError("tart not found; install with: brew install cirruslabs/cli/tart")
        image = CATALOG[vm["os"]]["tart"]
        name = vm["name"]
        d = vm_dir(name)
        gen_vm_key(d)
        vm["ssh"] = {"user": TART_VM_USER, "host": None, "port": 22,
                     "key": str(d / "id_ed25519")}
        log(f"cloning {image} (first pull can be large; sequoia is tens of GB)")
        cls._tart("delete", name, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        env = cls._env()
        env["TART_NO_AUTO_PRUNE"] = ""
        if run(["tart", "clone", image, name], env=env).returncode != 0:
            raise CliError(f"tart clone {image} failed")
        cls._configure(vm)
        cls._boot(vm, first_boot=True)
        inject_key(vm, TART_VM_PASSWORD)
        if CATALOG[vm["os"]]["sve_fix"]:
            cls._disable_sve(vm)

    @classmethod
    def _configure(cls, vm):
        argv = ["set", vm["name"]]
        if vm.get("cpu"):
            argv += ["--cpu", str(vm["cpu"])]
        if vm.get("ram"):
            argv += ["--memory", str(parse_size(vm["ram"], "--ram")[1])]
        if vm.get("hd"):
            _, mb = parse_size(vm["hd"], "--hd")
            argv += ["--disk-size", str(max(1, mb // 1024))]
        if len(argv) > 2 and cls._tart(*argv) != 0:
            raise CliError("tart set failed (note: --disk-size can only grow, and the "
                           "guest filesystem may not auto-grow)")

    @classmethod
    def _boot(cls, vm, first_boot=False):
        name = vm["name"]
        tart_log = vm_dir(name) / "tart.log"
        tart_log.write_text("")
        # --vnc-experimental binds a host VNC port for every guest type;
        # plain --vnc is Apple Screen Sharing and binds nothing for Linux
        # guests. No --dir share: transfer goes through `kora copy`, so what
        # you test is what you staged, never the caller's CWD.
        with open(tart_log, "ab") as lf:
            subprocess.Popen(["tart", "run", "--no-graphics", "--vnc-experimental",
                              name], env=cls._env(), stdout=lf, stderr=lf,
                             start_new_session=True)
        log("waiting for VM IP")
        deadline = time.time() + 180
        ip = ""
        while time.time() < deadline:
            _, out, _ = cls._tart("ip", name, capture=True)
            if re.fullmatch(r"(\d+\.){3}\d+", out):
                ip = out
                break
            time.sleep(1)
        if not ip:
            raise CliError(f"VM got no IP after 180s (see {tart_log})")
        vm["ssh"]["host"] = ip
        vm["tart"] = {"log": str(tart_log)}
        url = cls.vnc_url(vm)
        log(f"VM on {ip}" + (f"; VNC: {url}" if url else f" (VNC URL pending in {tart_log})"))
        # First boot: only password auth exists (key not injected yet). Later
        # boots must use the key - provisioning may disable password auth.
        wait_ssh(vm, 300, password=TART_VM_PASSWORD if first_boot else None)

    @classmethod
    def _disable_sve(cls, vm):
        # Apple Silicon advertises SVE to Linux guests without implementing
        # it; cryptography 47+/OpenSSL 4 SIGILLs on import
        # (pyca/cryptography#14733). Host-CPU misfeature -> kora owns the fix.
        log("disabling guest SVE (pyca/cryptography#14733); reboots the guest")
        vm_ssh(vm, "sudo sed -i 's|GRUB_CMDLINE_LINUX_DEFAULT=.*|"
                   "GRUB_CMDLINE_LINUX_DEFAULT=\"arm64.nosve\"|' /etc/default/grub",
               check=True)
        vm_ssh(vm, "sudo update-grub >/dev/null 2>&1", check=True)
        vm_ssh(vm, "sudo nohup reboot >/dev/null 2>&1 &")
        time.sleep(8)
        wait_ssh(vm, 300)

    @classmethod
    def is_running(cls, vm):
        # `tart ip` can answer from a stale lease right after stop - the
        # list state is the only truthful probe.
        rc, out, _ = cls._tart("list", "--source", "local", "--format", "json",
                               capture=True)
        if rc != 0:
            return False
        try:
            entries = json.loads(out)
        except json.JSONDecodeError:
            return False
        return any(e.get("Name") == vm["name"] and e.get("Running")
                   for e in entries)

    @classmethod
    def start(cls, vm):
        cls._boot(vm)   # IP may change; _boot refreshes vm["ssh"]["host"]

    @classmethod
    def stop(cls, vm):
        if cls._tart("stop", vm["name"]) != 0:
            raise CliError("tart stop failed")
        deadline = time.time() + 60
        while time.time() < deadline:
            if not cls.is_running(vm):
                return
            time.sleep(1)
        raise CliError("VM still running 60s after tart stop")

    @classmethod
    def destroy(cls, vm):
        cls._tart("stop", vm["name"], stdout=subprocess.DEVNULL,
                  stderr=subprocess.DEVNULL)
        cls._tart("delete", vm["name"], stdout=subprocess.DEVNULL,
                  stderr=subprocess.DEVNULL)

    @classmethod
    def vnc_url(cls, vm, attempts=10):
        for _ in range(attempts):
            try:
                text = Path(vm["tart"]["log"]).read_text()
            except (KeyError, FileNotFoundError):
                return None
            m = re.search(r"vnc://\S+", text)
            if m:
                return m.group(0)
            time.sleep(1)
        return None


class QemuArchBackend:
    """Arch Linux aarch64 under QEMU+hvf on macOS, installed unattended from
    the archboot ISO (cached per release under KORA_HOME/cache/archboot)."""
    name = "qemu-arch"

    @staticmethod
    def _release():
        return os.environ.get("KORA_ARCHBOOT_RELEASE", "latest")

    @classmethod
    def _fetch_release_assets(cls):
        rel = cls._release()
        base = f"{ARCHBOOT_BASE}/{rel}"
        cache = cache_dir("archboot", rel)
        key = cache / "release_key.pem"
        isos = list(cache.glob("*-ARCH-aarch64.iso"))
        if isos and key.exists() and rel != "latest":
            return isos[0], key
        rc, index, _ = run_out(["curl", "-so", "-", f"{base}/iso/"])
        if rc != 0:
            raise CliError(f"cannot reach {base}/iso/")
        m = re.search(r'href="[^"]*?([^"/]*-ARCH-aarch64\.iso)"', index)
        if not m:
            raise CliError(f"no aarch64 ISO listed at {base}/iso/ "
                           f"(pin a dated release with KORA_ARCHBOOT_RELEASE=YYYY.MM)")
        iso = cache / m.group(1)
        if not iso.exists():
            log(f"downloading archboot ISO {m.group(1)}")
            fetch(f"{base}/iso/{m.group(1)}", iso)
        rc, rel_txt, _ = run_out(["curl", "-so", "-", f"{base}/Release.txt"])
        km = re.search(r"-----BEGIN OPENSSH PRIVATE KEY-----.*?"
                       r"-----END OPENSSH PRIVATE KEY-----", rel_txt, re.S)
        if not km:
            raise CliError(f"no ssh key in {base}/Release.txt")
        key.write_text(km.group(0) + "\n")
        key.chmod(0o600)
        return iso, key

    @staticmethod
    def _firmware():
        fw = cache_dir("firmware") / "edk2-aarch64-code.fd"
        if not fw.exists():
            rc, found, _ = run_out(["find", "/opt/homebrew", "/usr/local",
                                    "-name", "edk2-aarch64-code.fd"])
            path = found.strip().splitlines()[0] if found.strip() else None
            if not path:
                raise CliError("edk2-aarch64-code.fd not found; install QEMU: brew install qemu")
            shutil.copy(path, fw)
        return fw

    @staticmethod
    def _blank_vars(vmdir):
        # Blank 64 MiB UEFI variable store, regenerated per boot (proven
        # behavior: boot falls through to the removable-media path).
        (vmdir / "efi-vars.fd").write_bytes(b"\0" * (64 * 1024 * 1024))

    @classmethod
    def create(cls, vm):
        if not shutil.which("qemu-system-aarch64"):
            raise CliError("qemu-system-aarch64 not found; install with: brew install qemu")
        d = vm_dir(vm["name"])
        gen_vm_key(d)
        cls._firmware()
        iso, release_key = cls._fetch_release_assets()
        port = alloc_port()
        disp = alloc_vnc_display()
        vm["qemu"] = {"ssh_port": port, "vnc_display": disp, "arch": "aarch64"}
        vm["ssh"] = {"user": "archboot", "host": "127.0.0.1", "port": port,
                     "key": str(d / "id_ed25519")}
        log(f"creating {vm['hd']} disk")
        if run(["qemu-img", "create", "-f", "qcow2", str(d / "disk.qcow2"),
                vm["hd"]]).returncode != 0:
            raise CliError("qemu-img create failed")
        cls._blank_vars(d)
        log("booting archboot installer (unattended install, ~10-20 min)")
        if run(qemu_arch_argv(vm, install_iso=iso)).returncode != 0:
            raise CliError("qemu installer boot failed")
        cls._serial_netfix(vm)
        cls._run_installer(vm, release_key)
        log("waiting for installer VM to power off")
        if not _qemu_wait_exit(vm, 600):
            raise CliError("installer did not power off within 10 min "
                           f"(console: {d / 'console.log'})")
        Path(arch_serial_sock(vm)).unlink(missing_ok=True)
        # Do NOT blank efi-vars here: grub-install just registered its boot
        # entry in them (the installer also puts GRUB on the removable path,
        # but the vars are kept as the primary boot source).
        log("booting installed Arch VM")
        if run(qemu_arch_argv(vm)).returncode != 0:
            raise CliError("qemu boot failed")
        wait_ssh(vm, 300)

    @classmethod
    def _serial_netfix(cls, vm, timeout=300):
        """archboot's live env (seen from 2026.08.31 on) boots with no
        address: its stock 10-wired-auto-dhcp.network lacks DHCP=yes and the
        installer's own profile matches enp0s1 while the live NIC is eth0 -
        so sshd listens but the hostfwd can never reach it. Drive the serial
        console to a root shell and write an eth0 DHCP profile; harmless when
        upstream networking already works, and the file is copied into the
        installed system by the installer (covers both NIC namings)."""
        d = vm_dir(vm["name"])
        sock_path = arch_serial_sock(vm)
        deadline = time.time() + timeout
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        while True:
            try:
                s.connect(str(sock_path))
                break
            except OSError:
                if time.time() > deadline:
                    raise CliError("archboot serial socket never appeared")
                time.sleep(1)
        s.settimeout(2)
        buf = b""
        lf = open(d / "console.log", "ab")

        def drain(seconds):
            nonlocal buf
            end = time.time() + seconds
            while time.time() < end:
                try:
                    data = s.recv(4096)
                    if not data:
                        return
                    buf += data
                    lf.write(data)
                except socket.timeout:
                    pass

        log("waiting for the archboot console banner")
        # match single words: the banner interleaves ANSI color escapes
        # between words, so multi-word substrings never appear contiguously
        while b"routine" not in buf and b"ENTER" not in buf:
            drain(2)
            if time.time() > deadline:
                lf.close()
                s.close()
                raise CliError("archboot console never showed its banner "
                               f"(see {d / 'console.log'})")
        s.sendall(b"\x03")      # CTRL-C -> root shell (per the banner)
        drain(3)
        log("enabling DHCP on the live environment's eth0")
        s.sendall(b"printf '[Match]\\nName=eth0\\n[Network]\\nDHCP=yes\\n'"
                  b" > /etc/systemd/network/20-eth0.network"
                  b" && systemctl restart systemd-networkd\n")
        drain(5)
        lf.flush()
        lf.close()
        s.close()

    @classmethod
    def _run_installer(cls, vm, release_key):
        d = vm_dir(vm["name"])
        installer = d / "archboot-install.sh"
        installer.write_text(ARCHBOOT_INSTALL_SH)
        # Install-phase ssh: root on archboot's sshd (guest 11838), release
        # key with passphrase 'Archboot'.
        phase = {"ssh": {"user": "root", "host": "127.0.0.1",
                         "port": vm["qemu"]["ssh_port"], "key": str(release_key)}}
        log("waiting for the archboot live environment's sshd")
        deadline = time.time() + 600
        while time.time() < deadline:
            if _password_ssh(phase, "exit 0", "Archboot",
                             extra=["-o", "ConnectTimeout=2"], quiet=True) == 0:
                break
            time.sleep(1)
        else:
            raise CliError("archboot sshd never answered; if 'latest' is mid-upload, "
                           "pin KORA_ARCHBOOT_RELEASE=YYYY.MM")
        time.sleep(2)
        def rootsh(cmd):
            if _password_ssh(phase, cmd, "Archboot") != 0:
                raise CliError(f"archboot install step failed: {cmd}")
        rootsh("rm -f /etc/profile.d/custom-bash-options.sh")
        cls._install_scp(phase, str(d / "id_ed25519.pub"), "/tmp/test_key.pub")
        cls._install_scp(phase, str(installer), "/tmp/archboot-install.sh")
        rootsh("chmod +x /tmp/archboot-install.sh")
        log("running unattended installer inside the VM")
        rootsh("cd /tmp && ./archboot-install.sh")
        _password_ssh(phase, "sleep 2; halt -p", "Archboot")

    @staticmethod
    def _install_scp(phase, src, dst):
        s = phase["ssh"]
        base = ["scp", *SSH_BASE_OPTS, "-P", str(s["port"]), "-i", s["key"],
                src, f"root@127.0.0.1:{dst}"]
        env = dict(os.environ)
        if shutil.which("sshpass"):
            argv = ["sshpass", "-e", "-P", "assphrase"] + base
            env["SSHPASS"] = "Archboot"
        else:
            argv = base
            env["SSH_ASKPASS"] = str(_askpass_script("Archboot"))
            env["SSH_ASKPASS_REQUIRE"] = "force"
            env.setdefault("DISPLAY", ":0")
        if run(argv, env=env).returncode != 0:
            raise CliError(f"scp to installer failed: {src}")

    @classmethod
    def is_running(cls, vm):
        pid = _qemu_pid(vm)
        return pid is not None and _pid_alive(pid)

    @classmethod
    def start(cls, vm):
        # vars persist across boots (they hold grub's NVRAM entry); recreate
        # only if lost - the removable-path GRUB still boots then.
        if not (vm_dir(vm["name"]) / "efi-vars.fd").exists():
            cls._blank_vars(vm_dir(vm["name"]))
        if run(qemu_arch_argv(vm)).returncode != 0:
            raise CliError("qemu boot failed")
        wait_ssh(vm, 300)

    @classmethod
    def stop(cls, vm):
        _qemu_stop(vm)

    @classmethod
    def destroy(cls, vm):
        _qemu_stop(vm, graceful=False)
        try:
            Path(arch_serial_sock(vm)).unlink(missing_ok=True)
        except (KeyError, OSError):
            pass

    @classmethod
    def vnc_url(cls, vm):
        return f"vnc://127.0.0.1:{5900 + vm['qemu']['vnc_display']}"


class QemuCloudimgBackend:
    """debian/ubuntu/arch x86_64 under QEMU+KVM on Linux hosts (including the
    cloud devbox): official cloud image as a qcow2 backing file + a cloud-init
    NoCloud seed ISO creating user 'kora'."""
    name = "qemu-cloudimg"

    @classmethod
    def create(cls, vm):
        cls._ensure_tools()
        url = CATALOG[vm["os"]]["cloudimg"]
        base = cache_dir("cloudimg") / url.rsplit("/", 1)[1]
        if not base.exists():
            log(f"downloading {url}")
            fetch(url, base)
        d = vm_dir(vm["name"])
        pub = gen_vm_key(d).with_suffix(".pub").read_text().strip()
        port = alloc_port()
        disp = alloc_vnc_display()
        vm["qemu"] = {"ssh_port": port, "vnc_display": disp, "arch": "x86_64"}
        vm["ssh"] = {"user": "kora", "host": "127.0.0.1", "port": port,
                     "key": str(d / "id_ed25519")}
        if run(["qemu-img", "create", "-f", "qcow2", "-b", str(base), "-F", "qcow2",
                str(d / "disk.qcow2"), vm["hd"]]).returncode != 0:
            raise CliError("qemu-img create failed")
        (d / "user-data").write_text(render_user_data(vm["name"], pub))
        (d / "meta-data").write_text(render_meta_data(vm["name"]))
        iso_tool = ensure_iso_tool()
        if run([*iso_tool, "-output", str(d / "seed.iso"), "-volid", "cidata",
                "-joliet", "-rock", str(d / "user-data"), str(d / "meta-data")],
               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
            raise CliError("cloud-init seed ISO build failed")
        log(f"booting {vm['os']} cloud image under KVM")
        if run(qemu_cloudimg_argv(vm)).returncode != 0:
            raise CliError("qemu boot failed")
        wait_ssh(vm, 300)

    @staticmethod
    def _ensure_tools():
        if not shutil.which("qemu-system-x86_64"):
            raise CliError("qemu-system-x86_64 not found; install with "
                           "'sudo apt-get install qemu-system-x86' or converge the "
                           "amun 'qemu' plugin")
        if not Path("/dev/kvm").exists():
            raise CliError("/dev/kvm missing - this host has no KVM (nested virt "
                           "disabled, or not a KVM-capable machine)")
        ensure_iso_tool()

    is_running = QemuArchBackend.is_running

    @classmethod
    def start(cls, vm):
        if run(qemu_cloudimg_argv(vm)).returncode != 0:
            raise CliError("qemu boot failed")
        wait_ssh(vm, 180)

    stop = QemuArchBackend.stop
    destroy = QemuArchBackend.destroy

    @classmethod
    def vnc_url(cls, vm):
        return f"vnc://127.0.0.1:{5900 + vm['qemu']['vnc_display']}"


BACKENDS = {b.name: b for b in (TartBackend, QemuArchBackend, QemuCloudimgBackend)}


def backend_name_for(os_name):
    """Host-platform dispatch for local VMs."""
    if os_name not in CATALOG:
        raise CliError(f"unknown OS '{os_name}' (kora list shows the catalog)")
    if HOST_OS == "darwin":
        return "tart" if CATALOG[os_name]["tart"] else "qemu-arch"
    if CATALOG[os_name]["cloudimg"] is None:
        raise CliError(f"'{os_name}' only runs locally on an Apple Silicon Mac (tart)")
    return "qemu-cloudimg"


def backend_for(vm):
    return BACKENDS[vm["backend"]]


# ---------------------------------------------------------------------------
# cloud proxy (persistent clouddevbox 'kvm', one per AWS profile)
# ---------------------------------------------------------------------------
def _require_clouddevbox():
    if not shutil.which("clouddevbox"):
        raise CliError("clouddevbox not found on PATH; install via gear: "
                       "~/.gear/com/clouddevbox/setup-darwin (repo: cn-cli-devbox)")


ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\r")


def resolve_profile(cli_profile):
    """Delegate AWS profile selection to clouddevbox (bullet picker on a tty).
    Runs `clouddevbox profile` under a pty so the interactive menu still
    renders while kora captures the chosen name (the last stdout line)."""
    if cli_profile:
        return cli_profile
    _require_clouddevbox()
    if sys.stdin.isatty():
        import pty
        chunks = []

        def _read(fd):
            data = os.read(fd, 1024)
            chunks.append(data)
            return data

        status = pty.spawn(["clouddevbox", "profile"], _read)
        text = ANSI_RE.sub("", b"".join(chunks).decode(errors="replace"))
        lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
        if (status and os.waitstatus_to_exitcode(status) != 0) or not lines:
            raise CliError("clouddevbox profile selection failed")
        profile = lines[-1]
    else:
        rc, out, err = run_out(["clouddevbox", "profile"])
        if rc != 0:
            raise CliError("profile resolution failed (non-tty): pass --profile <p>\n"
                           + err.strip())
        profile = out.strip().splitlines()[-1] if out.strip() else ""
    if not re.fullmatch(r"[A-Za-z0-9._-]+", profile or ""):
        raise CliError(f"could not parse the selected profile ({profile!r}); "
                       "pass --profile <p>")
    return profile


def _cdb(*argv, capture=False):
    if capture:
        return run_out(["clouddevbox", *argv])
    return run(["clouddevbox", *argv]).returncode


def box_status(profile):
    """-> (state, raw) where state is 'running'|'stopped'|'missing'|'other'."""
    rc, out, err = _cdb("status", CLOUD_BOX, "--profile", profile, capture=True)
    raw = out + err
    if rc != 0:
        if re.search(r"no (devbox|instance)|not found", raw, re.I):
            return "missing", raw
        raise CliError(f"clouddevbox status failed:\n{raw.strip()}")
    m = re.search(r"instance:.*-\s*(\w[\w-]*)", out)
    state = m.group(1) if m else "other"
    if state not in ("running", "stopped"):
        state = "other"
    return state, out


def ensure_devbox(profile, assume_yes):
    state, out = box_status(profile)
    if state == "missing":
        log(f"COST: {CLOUD_COST_LINE}")
        if not confirm(f"create devbox '{CLOUD_BOX}' (takes ~10 min)?", assume_yes):
            raise CliError("aborted")
        log(f"creating devbox '{CLOUD_BOX}' (--kvm, plugins: {CLOUD_BOX_PLUGINS})")
        if _cdb("new", CLOUD_BOX, "--kvm", "--profile", profile,
                "--plugins", CLOUD_BOX_PLUGINS) != 0:
            raise CliError("clouddevbox new failed")
    elif state == "stopped":
        log(f"starting devbox '{CLOUD_BOX}'")
        if _cdb("start", CLOUD_BOX, "--profile", profile) != 0:
            raise CliError("clouddevbox start failed")
    # SSHing during bootstrap races apt/dpkg locks - wait for the ledger.
    log("waiting for the box to be fully provisioned (15 min deadline)")
    deadline = time.time() + 900
    while True:
        _, out, _ = _cdb("status", CLOUD_BOX, "--profile", profile, capture=True)
        if "fully provisioned" in out:
            break
        if "FAILED" in out:
            raise CliError(f"box bootstrap FAILED:\n{out}")
        if time.time() >= deadline:
            raise CliError(f"box not fully provisioned after 15 min:\n{out}")
        time.sleep(30)
    # autostop counts per boot; re-assert so a running VM isn't shot early
    _cdb("autostop", CLOUD_BOX, CLOUD_AUTOSTOP, "--profile", profile)


def proxy_argv(profile, kora_args, tty=False):
    argv = ["clouddevbox", "ssh", CLOUD_BOX, "--profile", profile]
    if tty:
        argv.append("-t")
    argv += ["--", "~/bin/kora"] + [shlex.quote(a) for a in kora_args]
    return argv


def ensure_remote_kora(profile, state=None):
    """Push this exact file to the box when its hash differs - the working
    tree you run is the code that executes remotely, never a stale release."""
    self_path = os.path.abspath(__file__)
    local_sha = sha256_file(self_path)
    if state and state.get("cloud", {}).get("kora_sha") == local_sha:
        return local_sha
    rc, out, _ = _cdb("ssh", CLOUD_BOX, "--profile", profile, "--",
                      "sha256sum ~/bin/kora 2>/dev/null | cut -d\" \" -f1",
                      capture=True)
    remote_sha = out.strip().splitlines()[-1].strip() if out.strip() else ""
    if rc != 0 or remote_sha != local_sha:
        log("installing kora on the devbox")
        if _cdb("copy", self_path, f"{CLOUD_BOX}:/tmp/kora.new",
                "--profile", profile) != 0:
            raise CliError("clouddevbox copy of kora failed")
        if _cdb("ssh", CLOUD_BOX, "--profile", profile, "--",
                "mkdir -p ~/bin && install -m 0755 /tmp/kora.new ~/bin/kora "
                "&& rm -f /tmp/kora.new") != 0:
            raise CliError("remote kora install failed")
    return local_sha


def proxy(profile, kora_args, tty=False, capture=False):
    argv = proxy_argv(profile, kora_args, tty=tty)
    if capture:
        return run_out(argv)
    return run(argv).returncode


def remote_status_json(profile):
    rc, out, err = proxy(profile, ["status", "--json"], capture=True)
    if rc != 0:
        raise CliError(f"remote kora status failed:\n{(out + err).strip()}")
    try:
        return json.loads(out[out.index("{"):])
    except (ValueError, json.JSONDecodeError):
        raise CliError(f"unparseable remote status:\n{out}")


def cloud_state(state):
    return state is not None and state["backend"] == "cloud"


def _cloud_profile(state):
    return state["cloud"]["profile"]


def cloud_new(args):
    _require_clouddevbox()
    if args.os == "sequoia":
        raise CliError("macOS guests cannot run in the cloud (tart/Apple Silicon only)")
    profile = resolve_profile(args.profile)
    log(f"cloud mode: devbox '{CLOUD_BOX}', profile {profile}")
    ensure_devbox(profile, args.yes)
    sha = ensure_remote_kora(profile)
    remote_args = ["new", args.os]
    for flag, val in (("--ram", args.ram), ("--cpu", args.cpu), ("--hd", args.hd)):
        if val:
            remote_args += [flag, str(val)]
    if args.force:
        remote_args.append("--force")
    if proxy(profile, remote_args) != 0:
        raise CliError("remote kora new failed")
    remote = remote_status_json(profile)
    rvm = remote["vm"]
    cloud_dir = kora_home() / "cloud"
    cloud_dir.mkdir(mode=0o700, exist_ok=True)
    guest_key = cloud_dir / "id_ed25519"
    guest_key.unlink(missing_ok=True)
    if _cdb("copy", f"{CLOUD_BOX}:{rvm['ssh']['key']}", str(guest_key),
            "--profile", profile) != 0:
        raise CliError("could not pull the guest SSH key from the box")
    guest_key.chmod(0o600)
    vm = {
        "name": rvm["name"], "os": rvm["os"], "backend": "cloud",
        "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "cloud": {"box": CLOUD_BOX, "profile": profile, "kora_sha": sha,
                  "guest_ssh_port": rvm["qemu"]["ssh_port"],
                  "guest_vnc_display": rvm["qemu"]["vnc_display"],
                  "guest_user": rvm["ssh"]["user"],
                  "guest_key": str(guest_key)},
    }
    save_state(vm)
    log(f"cloud VM ready: {rvm['name']} ({rvm['os']}) on devbox '{CLOUD_BOX}'")
    log("connect: kora ssh | run: kora cmd '<command>' | display: kora vnc")


def cloud_tunnel(state, box_port):
    """clouddevbox tun for the mac->box hop, on a freshly allocated local
    port (a fixed port could collide with an unrelated local listener and
    fake tunnel readiness). Returns (Popen, local_port)."""
    local_port = alloc_port()
    argv = ["clouddevbox", "tun", CLOUD_BOX, str(local_port), str(box_port),
            "--profile", _cloud_profile(state)]
    p = subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not wait_tcp("127.0.0.1", local_port, 90):
        p.terminate()
        raise CliError(f"tunnel to the box did not come up on :{local_port}")
    return p, local_port


def _ensure_remote(state):
    """ensure_remote_kora + refresh the cached hash so later verbs skip the
    remote round trip until this file changes again."""
    profile = _cloud_profile(state)
    sha = ensure_remote_kora(profile, state)
    if state["cloud"].get("kora_sha") != sha:
        state["cloud"]["kora_sha"] = sha
        save_state(state)
    return profile


