def cmd_new(args):
    state = load_state()
    if state:
        if not args.force:
            where = "cloud" if cloud_state(state) else "local"
            raise CliError(f"a VM already exists: {state['name']} ({state['os']}, "
                           f"{where}); one VM at a time - run 'kora rm' first "
                           "or pass --force")
        log(f"--force: removing existing VM {state['name']}")
        _rm(state)
    if args.os not in CATALOG:
        raise CliError(f"unknown OS '{args.os}' (kora list shows the catalog)")
    if args.cloud:
        cloud_new(args)
        return
    backend_name = backend_name_for(args.os)
    is_qemu = backend_name.startswith("qemu")
    vm = {
        "name": new_vm_name(args.os), "os": args.os, "backend": backend_name,
        "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "ram": args.ram or (DEFAULT_QEMU_RAM if is_qemu else None),
        "cpu": int(args.cpu) if args.cpu else (DEFAULT_QEMU_CPU if is_qemu else None),
        "hd": args.hd or (DEFAULT_QEMU_HD if is_qemu else None),
    }
    if vm["ram"]:
        vm["ram"] = parse_size(vm["ram"], "--ram")[0]
    if vm["hd"]:
        vm["hd"] = parse_size(vm["hd"], "--hd")[0]
    backend = BACKENDS[backend_name]
    log(f"creating {vm['name']} ({args.os}, {backend_name})")
    try:
        backend.create(vm)
    except BaseException:
        if os.environ.get("KORA_KEEP_FAILED"):
            log(f"create failed; KORA_KEEP_FAILED set - artifacts left in "
                f"{vm_dir(vm['name'])}")
            raise
        log("create failed; cleaning up partial VM")
        try:
            backend.destroy(vm)
        except Exception:
            pass
        shutil.rmtree(vm_dir(vm["name"]), ignore_errors=True)
        raise
    save_state(vm)
    log(f"VM ready: {vm['name']} - kora ssh | kora cmd '<command>' | kora vnc")


def cmd_start(args):
    state = require_vm()
    if cloud_state(state):
        profile = _cloud_profile(state)
        ensure_devbox(profile, args.yes)
        _ensure_remote(state)
        sys.exit(proxy(profile, ["start"]))
    backend = backend_for(state)
    if backend.is_running(state):
        log("VM already running")
        return
    backend.start(state)
    save_state(state)
    log("VM started")


def cmd_stop(args):
    state = require_vm()
    if cloud_state(state):
        profile = _cloud_profile(state)
        bstate, _ = box_status(profile)
        if bstate != "running":
            log(f"devbox '{CLOUD_BOX}' is {bstate}; guest VM is not running")
            return
        rc = proxy(profile, ["stop"])
        log(f"the devbox itself keeps running (autostop {CLOUD_AUTOSTOP}); "
            f"stop it now with: clouddevbox stop {CLOUD_BOX} --profile {profile}")
        sys.exit(rc)
    backend_for(state).stop(state)
    log("VM stopped (disk kept; kora start resumes it)")


def _rm(state):
    if cloud_state(state):
        profile = _cloud_profile(state)
        bstate, _ = box_status(profile)
        if bstate == "running":
            ensure_remote_kora(profile, state)
            if proxy(profile, ["rm"]) != 0:
                raise CliError("remote kora rm failed")
            log(f"remote VM removed; the devbox persists - destroy it with: "
                f"clouddevbox destroy {CLOUD_BOX} --profile {profile}")
        else:
            log(f"devbox '{CLOUD_BOX}' is {bstate}; clearing local state only - "
                "the remote VM files remain on the box (next 'kora new --cloud "
                "--force' replaces them)")
        shutil.rmtree(kora_home() / "cloud", ignore_errors=True)
    else:
        backend_for(state).destroy(state)
        shutil.rmtree(vm_dir(state["name"]), ignore_errors=True)
    clear_state()


def cmd_rm(args):
    _rm(require_vm())
    log("VM removed")


def cmd_status(args):
    if args.side == "cloud":
        return _status_cloud(args)
    state = load_state()
    if not state:
        if args.json:
            print(json.dumps({"vm": None}))
        else:
            print("no VM (kora new <os> creates one)")
        return
    if cloud_state(state):
        profile = _cloud_profile(state)
        bstate, _ = box_status(profile)
        if args.json and bstate == "running":
            print(json.dumps(remote_status_json(profile)))
            return
        print(f"vm:      {state['name']} ({state['os']}) - cloud, on devbox "
              f"'{CLOUD_BOX}' (profile {profile})")
        print(f"devbox:  {bstate}")
        if bstate == "running":
            proxy(profile, ["status"])
        else:
            print(f"         kora start brings the box and the VM back up")
        return
    backend = backend_for(state)
    running = backend.is_running(state)
    if args.json:
        print(json.dumps({"vm": state, "running": running,
                          "home": str(kora_home()),
                          "vm_dir": str(vm_dir(state["name"]))}))
        return
    print(f"vm:      {state['name']} ({state['os']}, {state['backend']})")
    print(f"state:   {'running' if running else 'stopped'}")
    res = [f"{k}={state[k]}" for k in ("ram", "cpu", "hd") if state.get(k)]
    if res:
        print(f"size:    {' '.join(res)}")
    s = state["ssh"]
    print(f"ssh:     {s['user']}@{s['host']}:{s['port']} (kora ssh)")
    if running:
        url = backend.vnc_url(state, attempts=1) if state["backend"] == "tart" \
            else f"vnc://127.0.0.1:{5900 + state['qemu']['vnc_display']}"
        if url:
            print(f"vnc:     {url}")


def _status_cloud(args):
    _require_clouddevbox()
    state = load_state()
    if cloud_state(state):
        profile = _cloud_profile(state)
    else:
        profile = resolve_profile(args.profile)
    rc, out, err = _cdb("status", CLOUD_BOX, "--profile", profile, capture=True)
    if rc != 0:
        if re.search(r"no (devbox|instance)|not found", out + err, re.I):
            print(f"no '{CLOUD_BOX}' devbox for profile {profile} "
                  "(kora new <os> --cloud creates it)")
            return
        raise CliError((out + err).strip())
    print(out.rstrip())
    if "running" in out:
        print("-- remote kora --")
        rc2, rout, rerr = proxy(profile, ["status"], capture=True)
        print(rout.rstrip() if rc2 == 0 else
              "kora not installed on the box yet (kora new <os> --cloud installs it)")


def cmd_list(args):
    have_tart = shutil.which("tart") is not None
    have_qemu_a64 = shutil.which("qemu-system-aarch64") is not None
    have_kvm = shutil.which("qemu-system-x86_64") is not None and Path("/dev/kvm").exists()
    have_cdb = shutil.which("clouddevbox") is not None
    print(f"{'OS':<10}{'LOCAL':<38}CLOUD")
    for os_name, spec in CATALOG.items():
        if HOST_OS == "darwin":
            if spec["tart"]:
