class CliError(Exception):
    pass


# ---------------------------------------------------------------------------
# util
# ---------------------------------------------------------------------------
def log(msg):
    print(time.strftime("%Y/%m/%d %H:%M:%S") + f" [kora] {msg}", file=sys.stderr)


def run(argv, **kw):
    """Stream subprocess with inherited stdio; returns CompletedProcess."""
    return subprocess.run(argv, **kw)


def run_out(argv, **kw):
    """Capture stdout; returns (rc, stdout, stderr)."""
    p = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                       text=True, **kw)
    return p.returncode, p.stdout, p.stderr


def parse_size(s, what):
    """'2G'/'2048M' -> (canonical str, MiB int). Bare numbers mean GiB."""
    m = re.fullmatch(r"(\d+)([MmGg])?", str(s))
    if not m:
        raise CliError(f"invalid {what} '{s}' (use e.g. 2G or 2048M)")
    n, unit = int(m.group(1)), (m.group(2) or "G").upper()
    return f"{n}{unit}", n * 1024 if unit == "G" else n


def alloc_port(lo=SSH_PORT_RANGE[0], hi=SSH_PORT_RANGE[1]):
    for p in range(lo, hi + 1):
        with socket.socket() as s:
            try:
                s.bind(("127.0.0.1", p))
                return p
            except OSError:
                continue
    raise CliError(f"no free port in {lo}-{hi}")


def alloc_vnc_display():
    for d in range(*VNC_DISPLAY_RANGE):
        with socket.socket() as s:
            try:
                s.bind(("127.0.0.1", 5900 + d))
                return d
            except OSError:
                continue
    raise CliError("no free VNC display")


def wait_tcp(host, port, timeout):
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            with socket.create_connection((host, port), timeout=2):
                return True
        except OSError:
            time.sleep(1)
    return False


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def fetch(url, dest):
    """Download url to dest atomically (curl: available everywhere we run,
    shows progress, resumes are not needed since we cache)."""
    tmp = str(dest) + ".part"
    rc = run(["curl", "-fL", "-o", tmp, url]).returncode
    if rc != 0:
        Path(tmp).unlink(missing_ok=True)
        raise CliError(f"download failed: {url}")
    os.replace(tmp, dest)


def confirm(prompt, assume_yes):
    if assume_yes:
        return True
    if not sys.stdin.isatty():
        raise CliError("confirmation required but stdin is not a tty; pass --yes")
    return input(f"{prompt} [y/N] ").strip().lower() == "y"


# ---------------------------------------------------------------------------
# home / state
# ---------------------------------------------------------------------------
def default_data_home():
    if HOST_OS == "darwin":
        return Path.home() / "Library" / "Application Support" / "kora"
    return Path.home() / ".local" / "share" / "kora"


def kora_home():
    """State home: one VM per home. KORA_HOME overrides (used by harnesses for
    isolated runs); caches deliberately do NOT follow the override."""
    home = Path(os.environ["KORA_HOME"]) if os.environ.get("KORA_HOME") \
        else default_data_home()
    home.mkdir(mode=0o700, parents=True, exist_ok=True)
    return home


def state_path():
    return kora_home() / "state.json"


def load_state():
    try:
        return json.loads(state_path().read_text())
    except FileNotFoundError:
        return None
    except json.JSONDecodeError:
        raise CliError(f"corrupt state file {state_path()}; fix or delete it")


def save_state(state):
    state_path().write_text(json.dumps(state, indent=2) + "\n")


def clear_state():
    state_path().unlink(missing_ok=True)


def require_vm():
    state = load_state()
    if not state:
        raise CliError("no VM exists; create one with: kora new <os>")
    return state


def vm_dir(name):
    d = kora_home() / "vms" / name
    d.mkdir(mode=0o700, parents=True, exist_ok=True)
    return d


def cache_dir(*parts):
    """Images/ISOs/firmware: multi-GB, immutable, shared across every
    KORA_HOME so isolated harness runs never re-download. Survives `kora rm`."""
    d = default_data_home() / "cache"
    for p in parts:
        d = d / p
    d.mkdir(mode=0o700, parents=True, exist_ok=True)
    return d


def new_vm_name(os_name):
    return f"kora-{os_name}-{uuid.uuid4().hex[:6]}"


# ---------------------------------------------------------------------------
# ssh
# ---------------------------------------------------------------------------
def gen_vm_key(vmdir):
    key = vmdir / "id_ed25519"
    key.unlink(missing_ok=True)
    Path(str(key) + ".pub").unlink(missing_ok=True)
    rc = run(["ssh-keygen", "-t", "ed25519", "-f", str(key), "-N", "", "-q"]).returncode
    if rc != 0:
        raise CliError("ssh-keygen failed")
    key.chmod(0o600)
    return key


def ssh_target(vm):
    s = vm["ssh"]
    return s["user"], s["host"], s["port"], s["key"]


def ssh_argv(vm, command=None, interactive=False):
    user, host, port, key = ssh_target(vm)
    argv = ["ssh", *SSH_BASE_OPTS, "-p", str(port), "-i", key]
    if not interactive:
        argv += ["-o", "BatchMode=yes"]
    argv += [f"{user}@{host}"]
    if command:
        argv.append(command)
    return argv


def scp_argv(vm, src, dst, to_vm):
    user, host, port, key = ssh_target(vm)
    argv = ["scp", *SSH_BASE_OPTS, "-P", str(port), "-i", key]
    remote = f"{user}@{host}:"
    return argv + ([src, remote + dst] if to_vm else [remote + src, dst])


def build_remote_command(args):
    """kora cmd semantics: a single argument is a shell string passed through
    verbatim (kora cmd 'a && b'); multiple arguments are quoted per-token."""
    return args[0] if len(args) == 1 else shlex.join(args)


def vm_ssh(vm, command, check=False, quiet=False):
    kw = {}
    if quiet:
        kw = {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}
    rc = run(ssh_argv(vm, command), **kw).returncode
    if check and rc != 0:
        raise CliError(f"ssh command failed (rc={rc}): {command}")
    return rc


def wait_ssh(vm, timeout, password=None):
    """Poll until ssh answers. With password set, authenticate by password
    (sshpass if present, SSH_ASKPASS otherwise) - used before key injection.

    Each probe is hard-capped: ConnectTimeout only bounds the TCP connect, not
    the banner exchange, and a fresh guest whose sshd is still generating host
    keys can stall a probe indefinitely - a couple of those would otherwise
    eat the whole budget."""
    log(f"waiting for SSH on {vm['ssh']['host']}:{vm['ssh']['port']}")
    deadline = time.time() + timeout
    # -oConnectionAttempts + a subprocess timeout together bound each probe
    probe_extra = ["-o", "ConnectTimeout=4"]
    while time.time() < deadline:
        try:
            if password:
                rc = _password_ssh(vm, "true", password, extra=probe_extra,
                                   quiet=True, hard_timeout=15)
            else:
                user, host, port, key = ssh_target(vm)
                rc = run(["ssh", *SSH_BASE_OPTS, "-o", "BatchMode=yes",
                          *probe_extra, "-p", str(port), "-i", key,
                          f"{user}@{host}", "true"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         timeout=15).returncode
        except subprocess.TimeoutExpired:
            rc = 1      # banner stall - keep polling, do not burn the budget
        if rc == 0:
            return
        time.sleep(1)
    raise CliError(f"SSH not reachable after {timeout}s "
                   f"({vm['ssh']['host']}:{vm['ssh']['port']})")


def _askpass_script(password):
    d = kora_home() / "tmp"
    d.mkdir(mode=0o700, exist_ok=True)
    p = d / f"askpass-{os.getpid()}.sh"
    p.write_text(f"#!/bin/sh\necho {shlex.quote(password)}\n")
    p.chmod(0o700)
    return p


def _password_ssh(vm, command, password, extra=None, stdin_file=None,
                  quiet=False, hard_timeout=None):
    """ssh with password/passphrase auth: sshpass when available, else
    SSH_ASKPASS_REQUIRE=force (OpenSSH >= 8.4). hard_timeout bounds the whole
    attempt (banner stalls); it re-raises subprocess.TimeoutExpired."""
    user, host, port, key = ssh_target(vm)
    passphrase_mode = bool(key) and Path(key).exists() and password != TART_VM_PASSWORD
    base = ["ssh", *SSH_BASE_OPTS, "-p", str(port), *(extra or [])]
    if passphrase_mode:
        base += ["-i", key]     # passphrase-protected key (archboot install phase)
    base += [f"{user}@{host}", command]
    env = dict(os.environ)
    if shutil.which("sshpass"):
        # sshpass matches "assword" by default; key passphrases prompt
        # "Enter passphrase for ..." and need -P assphrase instead.
        argv = ["sshpass", "-e"] + (["-P", "assphrase"] if passphrase_mode else []) + base
        env["SSHPASS"] = password
    else:
        argv = base
        env["SSH_ASKPASS"] = str(_askpass_script(password))
        env["SSH_ASKPASS_REQUIRE"] = "force"
        env.setdefault("DISPLAY", ":0")
    kw = {"env": env}
    if stdin_file:
        kw["stdin"] = open(stdin_file, "rb")
    if quiet:
        kw["stdout"] = subprocess.DEVNULL
        kw["stderr"] = subprocess.DEVNULL
    if hard_timeout:
        kw["timeout"] = hard_timeout
    try:
        return run(argv, **kw).returncode
    finally:
        if stdin_file:
            kw["stdin"].close()


def inject_key(vm, password):
    """Append the per-VM pubkey to authorized_keys using password auth. Needed
    because provisioning payloads (amun remoteaccess) may later disable
    PasswordAuthentication - key SSH must already work by then."""
    log(f"injecting per-VM SSH key for {vm['ssh']['user']}")
    rc = _password_ssh(
        vm,
        "mkdir -p ~/.ssh && chmod 700 ~/.ssh && cat >> ~/.ssh/authorized_keys "
        "&& chmod 600 ~/.ssh/authorized_keys",
        password, stdin_file=vm["ssh"]["key"] + ".pub")
    if rc != 0:
        raise CliError("SSH key injection failed")


