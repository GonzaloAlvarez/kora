# qemu argv builders (pure - unit-testable)
# ---------------------------------------------------------------------------
def qemu_common_argv(vm, hostfwd_guest_port, serial=None):
    q = vm["qemu"]
    d = vm_dir(vm["name"])
    return [
        "-smp", str(vm["cpu"]), "-m", vm["ram"],
        "-device", "virtio-net-pci,netdev=net0",
        "-netdev", ("user,id=net0,hostfwd=tcp:127.0.0.1:"
                    f"{q['ssh_port']}-:{hostfwd_guest_port}"),
        "-display", "none", "-monitor", "none",
        "-serial", serial or f"file:{d / 'console.log'}",
        "-vnc", f"127.0.0.1:{q['vnc_display']}",
        "-pidfile", str(d / "qemu.pid"),
        "-daemonize",
    ]


def arch_serial_sock(vm):
    # A short path: macOS caps AF_UNIX paths at ~104 bytes and a mktemp
    # KORA_HOME (e.g. amun/test's per-run home under /var/folders/...) blows
    # past that. Keyed by the per-VM ssh_port so concurrent VMs don't collide.
    return f"/tmp/kora-arch-{vm['qemu']['ssh_port']}.sock"


def qemu_arch_argv(vm, install_iso=None):
    """aarch64 + hvf on macOS (archboot). Install phase forwards archboot's
    sshd (11838) and exposes the serial console on a unix socket so
    _serial_netfix can drive it; run phase forwards 22 and logs the console."""
    d = vm_dir(vm["name"])
    serial = (f"unix:{arch_serial_sock(vm)},server=on,wait=off"
              if install_iso else None)
    argv = [
        "qemu-system-aarch64",
        "-machine", "virt,accel=hvf",
        "-cpu", "host",
        "-device", "nvme,drive=disk0,serial=d0",
        "-drive", f"id=disk0,if=none,format=qcow2,file={d / 'disk.qcow2'},discard=on",
        "-drive", f"if=pflash,format=raw,file={cache_dir('firmware') / 'edk2-aarch64-code.fd'},readonly=on",
        "-drive", f"if=pflash,format=raw,file={d / 'efi-vars.fd'}",
    ] + qemu_common_argv(vm, 11838 if install_iso else 22, serial=serial)
    if install_iso:
        argv += ["-cdrom", str(install_iso), "-boot", "d"]
    return argv


def qemu_cloudimg_argv(vm):
    """x86_64 + KVM on Linux (official cloud images + cloud-init seed)."""
    d = vm_dir(vm["name"])
    return [
        "qemu-system-x86_64",
        "-machine", "q35",
        "-enable-kvm",
        "-cpu", "host",
        "-drive", f"if=virtio,format=qcow2,file={d / 'disk.qcow2'},discard=unmap",
        "-drive", f"if=virtio,format=raw,file={d / 'seed.iso'},readonly=on",
    ] + qemu_common_argv(vm, 22)


def render_user_data(name, pubkey):
    return (
        "#cloud-config\n"
        f"hostname: {name}\n"
        "users:\n"
        "  - name: kora\n"
        "    sudo: \"ALL=(ALL) NOPASSWD:ALL\"\n"
        "    shell: /bin/bash\n"
        "    lock_passwd: true\n"
        "    ssh_authorized_keys:\n"
        f"      - {pubkey}\n"
        "ssh_pwauth: false\n"
    )


def render_meta_data(name):
    return f"instance-id: {name}\nlocal-hostname: {name}\n"


def _qemu_pid(vm):
    try:
        return int((vm_dir(vm["name"]) / "qemu.pid").read_text().strip())
    except (FileNotFoundError, ValueError):
        return None


def _pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False
    except TypeError:
        return False


def _qemu_wait_exit(vm, timeout):
    deadline = time.time() + timeout
    pid = _qemu_pid(vm)
    while time.time() < deadline:
        if pid is None or not _pid_alive(pid):
            return True
        time.sleep(1)
    return False


def _qemu_stop(vm, graceful=True):
    """PID-file discipline: poweroff over ssh, then SIGTERM, then SIGKILL."""
    pid = _qemu_pid(vm)
    if pid is None or not _pid_alive(pid):
        return
    if graceful:
        vm_ssh(vm, "sudo poweroff", quiet=True)
        if _qemu_wait_exit(vm, 45):
            return
        log("graceful poweroff timed out; terminating qemu")
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    if not _qemu_wait_exit(vm, 10):
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass


def ensure_iso_tool():
    for tool in ("genisoimage", "mkisofs"):
        if shutil.which(tool):
            return [tool]
    if shutil.which("xorriso"):
        return ["xorriso", "-as", "mkisofs"]
    raise CliError("no ISO tool found (genisoimage/mkisofs/xorriso); install with "
                   "'sudo apt-get install genisoimage' (Debian/Ubuntu), "
                   "'sudo pacman -S cdrtools' (Arch) or converge the amun 'qemu' plugin")


